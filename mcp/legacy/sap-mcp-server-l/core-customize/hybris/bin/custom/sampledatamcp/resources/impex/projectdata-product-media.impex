# ---------------------------------------------------------------------------
# Wire product images for the 20 ThinkShop products. Mirrors the
# `marketplacestore/products-media.impex` pattern:
#   - `$siteResource` uses hybris's `jar:` URL scheme to reference files
#     packaged inside the sampledatamcp extension's classpath, which is
#     environment-independent (works on dev, CI, CCv2).
#   - Media is catalog-versioned; one row per version.
#   - The `mediaContainer` column lets us group hero/thumbnail into a single
#     MediaContainer the storefront understands.
#
# Image files live at:
#   bin/custom/sampledatamcp/resources/sampledatamcp/import/images/products/
#
# Load via:
#   ./gradlew impex -Pfile=hybris/bin/custom/sampledatamcp/resources/impex/projectdata-product-media.impex
# ---------------------------------------------------------------------------

$productCatalog        = electronicsProductCatalog
$onlineVersion         = catalogVersion(catalog(id[default = $productCatalog]), version[default = 'Online'])[unique = true]
$stagedVersion         = catalogVersion(catalog(id[default = $productCatalog]), version[default = 'Staged'])[unique = true]
$siteResource          = jar:com.sampledatamcp.constants.SampledatamcpConstants&/sampledatamcp/import/images/products


# ==========================================================================
# Media — one row per catalog version per product (40 rows total)
# Column order matches the marketplacestore/products-media canonical pattern.
# ==========================================================================

INSERT_UPDATE Media ; code[unique = true]       ; @media[translator = de.hybris.platform.impex.jalo.media.MediaDataTranslator] ; mime[default = 'image/png'] ; $stagedVersion ; folder(qualifier)[default = images]
                    ; img-LAPTOP_PRO_15         ; $siteResource/LAPTOP_PRO_15.png           ;                              ;                ;
                    ; img-SMARTPHONE_X          ; $siteResource/SMARTPHONE_X.png            ;                              ;                ;
                    ; img-WIRELESS_HEADPHONES   ; $siteResource/WIRELESS_HEADPHONES.png     ;                              ;                ;
                    ; img-TABLET_AIR            ; $siteResource/TABLET_AIR.png              ;                              ;                ;
                    ; img-SMART_WATCH_PRO       ; $siteResource/SMART_WATCH_PRO.png         ;                              ;                ;
                    ; img-MECHANICAL_KEYBOARD   ; $siteResource/MECHANICAL_KEYBOARD.png     ;                              ;                ;
                    ; img-WIRELESS_GAMING_MOUSE ; $siteResource/WIRELESS_GAMING_MOUSE.png   ;                              ;                ;
                    ; img-MONITOR_4K_27         ; $siteResource/MONITOR_4K_27.png           ;                              ;                ;
                    ; img-HD_WEBCAM             ; $siteResource/HD_WEBCAM.png               ;                              ;                ;
                    ; img-BLUETOOTH_SPEAKER     ; $siteResource/BLUETOOTH_SPEAKER.png       ;                              ;                ;
                    ; img-TS_MUG_CLASSIC        ; $siteResource/TS_MUG_CLASSIC.png          ;                              ;                ;
                    ; img-TS_MUG_TRAVEL         ; $siteResource/TS_MUG_TRAVEL.png           ;                              ;                ;
                    ; img-TS_TEE_BLACK          ; $siteResource/TS_TEE_BLACK.png            ;                              ;                ;
                    ; img-TS_TEE_WHITE          ; $siteResource/TS_TEE_WHITE.png            ;                              ;                ;
                    ; img-TS_HOODIE_ZIP         ; $siteResource/TS_HOODIE_ZIP.png           ;                              ;                ;
                    ; img-TS_CAP_DAD            ; $siteResource/TS_CAP_DAD.png              ;                              ;                ;
                    ; img-TS_STICKER_PACK       ; $siteResource/TS_STICKER_PACK.png         ;                              ;                ;
                    ; img-TS_TOTE_CANVAS       ; $siteResource/TS_TOTE_CANVAS.png         ;                              ;                ;
                    ; img-TS_BOTTLE_STEEL       ; $siteResource/TS_BOTTLE_STEEL.png         ;                              ;                ;
                    ; img-TS_NOTEBOOK_DEV       ; $siteResource/TS_NOTEBOOK_DEV.png         ;                              ;                ;

INSERT_UPDATE Media ; code[unique = true]       ; @media[translator = de.hybris.platform.impex.jalo.media.MediaDataTranslator] ; mime[default = 'image/png'] ; $onlineVersion ; folder(qualifier)[default = images]
                    ; img-LAPTOP_PRO_15         ; $siteResource/LAPTOP_PRO_15.png           ;                              ;                ;
                    ; img-SMARTPHONE_X          ; $siteResource/SMARTPHONE_X.png            ;                              ;                ;
                    ; img-WIRELESS_HEADPHONES   ; $siteResource/WIRELESS_HEADPHONES.png     ;                              ;                ;
                    ; img-TABLET_AIR            ; $siteResource/TABLET_AIR.png              ;                              ;                ;
                    ; img-SMART_WATCH_PRO       ; $siteResource/SMART_WATCH_PRO.png         ;                              ;                ;
                    ; img-MECHANICAL_KEYBOARD   ; $siteResource/MECHANICAL_KEYBOARD.png     ;                              ;                ;
                    ; img-WIRELESS_GAMING_MOUSE ; $siteResource/WIRELESS_GAMING_MOUSE.png   ;                              ;                ;
                    ; img-MONITOR_4K_27         ; $siteResource/MONITOR_4K_27.png           ;                              ;                ;
                    ; img-HD_WEBCAM             ; $siteResource/HD_WEBCAM.png               ;                              ;                ;
                    ; img-BLUETOOTH_SPEAKER     ; $siteResource/BLUETOOTH_SPEAKER.png       ;                              ;                ;
                    ; img-TS_MUG_CLASSIC        ; $siteResource/TS_MUG_CLASSIC.png          ;                              ;                ;
                    ; img-TS_MUG_TRAVEL         ; $siteResource/TS_MUG_TRAVEL.png           ;                              ;                ;
                    ; img-TS_TEE_BLACK          ; $siteResource/TS_TEE_BLACK.png            ;                              ;                ;
                    ; img-TS_TEE_WHITE          ; $siteResource/TS_TEE_WHITE.png            ;                              ;                ;
                    ; img-TS_HOODIE_ZIP         ; $siteResource/TS_HOODIE_ZIP.png           ;                              ;                ;
                    ; img-TS_CAP_DAD            ; $siteResource/TS_CAP_DAD.png              ;                              ;                ;
                    ; img-TS_STICKER_PACK       ; $siteResource/TS_STICKER_PACK.png         ;                              ;                ;
                    ; img-TS_TOTE_CANVAS        ; $siteResource/TS_TOTE_CANVAS.png          ;                              ;                ;
                    ; img-TS_BOTTLE_STEEL       ; $siteResource/TS_BOTTLE_STEEL.png         ;                              ;                ;
                    ; img-TS_NOTEBOOK_DEV       ; $siteResource/TS_NOTEBOOK_DEV.png         ;                              ;                ;


# ==========================================================================
# Wire each Media as both thumbnail + picture on the Product (both versions).
# The Media lookup is catalog-version-scoped, so img-X here resolves to the
# matching Media row in the same catalog version as the Product update.
# ==========================================================================

UPDATE Product ; code[unique = true]    ; $stagedVersion ; thumbnail(code, $stagedVersion) ; picture(code, $stagedVersion)
               ; LAPTOP_PRO_15          ;                ; img-LAPTOP_PRO_15               ; img-LAPTOP_PRO_15
               ; SMARTPHONE_X           ;                ; img-SMARTPHONE_X                ; img-SMARTPHONE_X
               ; WIRELESS_HEADPHONES    ;                ; img-WIRELESS_HEADPHONES         ; img-WIRELESS_HEADPHONES
               ; TABLET_AIR             ;                ; img-TABLET_AIR                  ; img-TABLET_AIR
