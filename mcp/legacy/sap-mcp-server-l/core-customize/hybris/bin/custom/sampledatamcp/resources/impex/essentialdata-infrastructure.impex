# ---------------------------------------------------------------------------
# ThinkShop store infrastructure
#
# Loaded automatically during "ant initialize" AND "ant updatesystem"
# (filename matches essentialdata-*.impex)
#
# Sorts before essentialdata-solr.impex ('i' < 's') so catalog and currency
# exist before Solr config references them.
#
# Creates: OAuth clients, currency, catalog, base store/site, delivery/payment modes
# ---------------------------------------------------------------------------

#% impex.setLocale(new java.util.Locale("en"));

$productCatalog = electronicsProductCatalog
$currency = USD
$language = en
$country = US
$zone = usa
$warehouse = electronics-warehouse
$vendor = electronics-vendor
$store = electronics
$userTaxGroup = us-taxes
$productTaxGroup = us-sales-tax-full
$paymentMode = advance


# ==========================================================================
# OAuth Clients
# ==========================================================================

INSERT_UPDATE OAuthClientDetails ; clientId[unique = true] ; resourceIds ; scope    ; authorizedGrantTypes                                         ; authorities         ; clientSecret ; registeredRedirectUri
                                 ; trusted_client          ; hybris      ; extended ; authorization_code,refresh_token,password,client_credentials ; ROLE_TRUSTED_CLIENT ; secret       ;
                                 ; mobile_android          ; hybris      ; basic    ; authorization_code,refresh_token,password,client_credentials ; ROLE_CLIENT         ; secret       ; http://localhost:9001/authorizationserver/oauth2_callback


# ==========================================================================
# Language
# ==========================================================================

INSERT_UPDATE Language ; isocode[unique = true] ; active
                       ; $language              ; true


# ==========================================================================
# Currency
# ==========================================================================

INSERT_UPDATE Currency ; isocode[unique = true] ; active ; conversion ; digits ; symbol
                       ; $currency              ; true   ; 1          ; 2      ; $


# ==========================================================================
# Country
# ==========================================================================

INSERT_UPDATE Country ; isocode[unique = true] ; name[lang = $language] ; active
                      ; $country               ; United States          ; true


# ==========================================================================
# Unit
# ==========================================================================

INSERT_UPDATE Unit ; unitType[unique = true] ; code[unique = true] ; name[lang = $language] ; conversion
                   ; pieces                  ; pieces              ; Pieces                 ; 1


# ==========================================================================
# Catalog & Catalog Versions
# ==========================================================================

INSERT_UPDATE Catalog ; id[unique = true]     ; name[lang = $language]
                      ; $productCatalog       ; Electronics Product Catalog

INSERT_UPDATE CatalogVersion ; catalog(id)[unique = true] ; version[unique = true] ; active ; languages(isocode)
                             ; $productCatalog            ; Staged                 ; false  ; $language
                             ; $productCatalog            ; Online                 ; true   ; $language


# ==========================================================================
# Vendor (required by Warehouse)
# ==========================================================================

INSERT_UPDATE Vendor ; code[unique = true]  ; name[lang = $language]
                     ; $vendor              ; Electronics Vendor


# ==========================================================================
# Warehouse
# ==========================================================================

INSERT_UPDATE Warehouse ; code[unique = true]   ; name[lang = $language] ; vendor(code) ; default
                        ; $warehouse            ; Electronics Warehouse  ; $vendor      ; true


# ==========================================================================
# Tax Groups & Tax (0% — prices display as entered)
# ==========================================================================

INSERT_UPDATE UserTaxGroup ; code[unique = true]
                           ; $userTaxGroup

INSERT_UPDATE ProductTaxGroup ; code[unique = true]
                              ; $productTaxGroup

INSERT_UPDATE Tax ; code[unique = true] ; value ; currency(isocode)
                  ; $productTaxGroup    ; 0

# TaxRow links Tax ↔ ProductTaxGroup ↔ UserTaxGroup within the catalog
# TaxRow is catalog-versioned (part-of Product) — import to both Staged and Online
$stagedVersion = catalogVersion(catalog(id[default = $productCatalog]), version[default = 'Staged'])[unique = true]
$onlineVersion = catalogVersion(catalog(id[default = $productCatalog]), version[default = 'Online'])[unique = true]

INSERT_UPDATE TaxRow ; $stagedVersion ; tax(code)[unique = true] ; pg(code)[unique = true] ; ug(code)[unique = true]
                     ;                ; $productTaxGroup         ; $productTaxGroup        ; $userTaxGroup

INSERT_UPDATE TaxRow ; $onlineVersion ; tax(code)[unique = true] ; pg(code)[unique = true] ; ug(code)[unique = true]
                     ;                ; $productTaxGroup         ; $productTaxGroup        ; $userTaxGroup


# ==========================================================================
# Delivery Mode (ZoneDeliveryMode required for OCC checkout)
# ==========================================================================

INSERT_UPDATE Zone ; code[unique = true] ; countries(isocode)
                   ; $zone               ; $country

INSERT_UPDATE ZoneDeliveryMode ; code[unique = true]        ; name[lang = $language] ; active ; net
                               ; thinkshop-standard         ; Standard Delivery      ; true   ; false
                               ; thinkshop-express          ; Express Delivery       ; true   ; false
                               ; thinkshop-free-delivery    ; Free Delivery          ; true   ; false

INSERT_UPDATE ZoneDeliveryModeValue ; deliveryMode(code)[unique = true] ; zone(code)[unique = true] ; currency(isocode)[unique = true] ; value ; minimum[unique = true]
                                    ; thinkshop-standard                ; $zone                     ; $currency                        ; 5.99  ; 0.00
                                    ; thinkshop-express                 ; $zone                     ; $currency                        ; 14.99 ; 0.00
                                    ; thinkshop-free-delivery           ; $zone                     ; $currency                        ; 0.00  ; 0.00


# ==========================================================================
# Payment Mode
# ==========================================================================

INSERT_UPDATE StandardPaymentMode ; code[unique = true] ; name[lang = $language] ; description[lang = $language] ; active ; paymentinfotype(code)
                                  ; $paymentMode        ; Advance                ; payment in advance            ; true   ; AdvancePaymentInfo

INSERT_UPDATE StandardPaymentModeValue ; paymentMode(code)[unique = true] ; value ; currency(isocode)[unique = true]
                                       ; $paymentMode                     ; 0.00  ; $currency


# ==========================================================================
# ATP Formula (required by warehousing extension for stock availability)
# ==========================================================================

INSERT_UPDATE AtpFormula ; code[unique = true]    ; availability ; allocation ; cancellation ; increase ; reserved ; shrinkage ; wastage ; returned ; external
                         ; thinkshop-atp-formula  ; true         ; true       ; false        ; false    ; true     ; false     ; false   ; false    ; false


# ==========================================================================
# Base Store
# ==========================================================================

INSERT_UPDATE BaseStore ; uid[unique = true] ; catalogs(id)    ; currencies(isocode) ; defaultCurrency(isocode) ; defaultLanguage(isocode) ; languages(isocode) ; net   ; taxGroup(code) ; warehouses(code) ; paymentProvider ; defaultAtpFormula(code)
                        ; $store             ; $productCatalog ; $currency           ; $currency                ; $language                ; $language          ; false ; $userTaxGroup  ; $warehouse       ; Mockup          ; thinkshop-atp-formula

UPDATE BaseStore ; uid[unique = true] ; deliveryCountries(isocode)
                 ; $store             ; $country

# Only list user-selectable delivery modes here.
# thinkshop-free-delivery is NOT listed — it exists for the promotion engine
# to apply via y_change_delivery_mode, but should not appear in the checkout picker.
UPDATE BaseStore ; uid[unique = true] ; deliveryModes(code)
                 ; $store             ; thinkshop-standard,thinkshop-express


# ==========================================================================
# Promotion Website Group
# ==========================================================================

INSERT_UPDATE PromotionGroup ; Identifier[unique = true]
                             ; thinkshopPromoGrp

# ==========================================================================
# CMS Site (follows accelerator pattern — CMSSite extends BaseSite)
# ==========================================================================

INSERT_UPDATE CMSSite ; uid[unique = true] ; stores(uid) ; defaultLanguage(isocode) ; channel(code) ; active ; defaultPromotionGroup(Identifier) ; urlPatterns
                      ; $store             ; $store      ; $language                ; B2C           ; true   ; thinkshopPromoGrp                 ; (?i)^https?://[^/]+(|/.*|\?.*)$


# ==========================================================================
# Customer Group
# ==========================================================================

INSERT_UPDATE UserGroup ; uid[unique = true]
                        ; customergroup
