# ---------------------------------------------------------------------------
# ThinkShop knowledge base seed data (15 entries)
#
# Loaded on "ant initialize" (filename matches projectdata-*.impex). To
# refresh on a running instance use:
#   ./gradlew impex -Pfile=hybris/bin/custom/sampledatamcp/resources/impex/projectdata-knowledge.impex
#
# After import, trigger the Solr full index for knowledgeIndex.
# ---------------------------------------------------------------------------

#% impex.setLocale(new java.util.Locale("en"));

$language       = en
$published      = status(code)[default = published]
$cat            = category(code)
$dateFmt        = dateformat = dd.MM.yyyy HH:mm


# ==========================================================================
# Knowledge entries
# ==========================================================================
# NOTE: ';' is the ImpEx column separator. Avoid raw semicolons inside text;
# use commas or em-dashes instead.

INSERT_UPDATE KnowledgeEntry ; uid[unique = true]   ; $cat    ; title[lang = $language]            ; summary[lang = $language]                                                              ; body[lang = $language]                                                                                                                                                                                                                                                                                              ; tags                                          ; validFrom[$dateFmt] ; validTo[$dateFmt]   ; priority ; imageUrl                                                                            ; $published
                             ; returns-policy       ; policy  ; Returns & refunds                  ; 30-day hassle-free returns on all ThinkShop orders, free return shipping included.       ; "We accept returns on most items within 30 days of delivery. Items must be in original condition with all packaging. Return shipping is on us — print a prepaid label from your order page. Refunds land on your original payment method within 5-7 business days after we receive the return."                       ; returns,refunds,exchange,policy               ;                     ;                     ; 100      ;                                                                                     ;
                             ; shipping-info        ; policy  ; Shipping methods and timing        ; Standard, 2-day, and overnight options. Free standard shipping on orders over $50.       ; "Standard shipping (5-7 business days) is free on orders $50 and up, otherwise $5.99. Two-day shipping is $12.99 and overnight is $24.99. We ship to the contiguous US, Alaska, Hawaii, and Canada. International shipping is available to 40+ countries — rates calculated at checkout."                              ; shipping,delivery,free shipping,policy        ;                     ;                     ; 95       ;                                                                                     ;
                             ; warranty             ; policy  ; Warranty and satisfaction promise  ; 1-year manufacturer warranty plus our 90-day ThinkShop satisfaction guarantee.           ; "All electronics carry the full manufacturer warranty (typically 12 months). On top of that, ThinkShop's 90-day satisfaction guarantee lets you exchange or refund any product that doesn't meet your expectations — no questions asked, no restocking fees."                                                          ; warranty,guarantee,satisfaction,policy        ;                     ;                     ; 80       ;                                                                                     ;
                             ; privacy-policy       ; policy  ; Privacy and your data              ; We collect only what we need to fulfill your order, and never sell your data.            ; "ThinkShop collects account, order, and payment information solely to process your purchases and improve our service. We never sell or rent personal data to third parties. You can request a copy or deletion of your data anytime from your account settings. Full policy at thinkshop.com/privacy."                ; privacy,data,gdpr,policy                      ;                     ;                     ; 50       ;                                                                                     ;
                             ; payment-methods      ; policy  ; Accepted payment methods           ; Cards, PayPal, ThinkShop gift cards, and Buy Now Pay Later (4 interest-free payments).   ; "We accept Visa, Mastercard, American Express, Discover, PayPal, Apple Pay, Google Pay, ThinkShop gift cards, and BNPL via Klarna or Affirm (4 interest-free payments on orders $100+). All transactions are encrypted end-to-end."                                                                                       ; payment,credit card,paypal,bnpl,gift card     ;                     ;                     ; 70       ;                                                                                     ;
                             ; about-thinkshop      ; brand   ; About ThinkShop                    ; Founded in 2018 by three engineers who wanted a tech shop that actually understood tech. ; "ThinkShop started in a garage in Austin in 2018 when three engineers got tired of buying gear from sellers who couldn't tell SSD from HDD. Today we curate the best electronics and merch for people who care about how their tools work — backed by real specs, honest reviews, and humans on chat who get it."     ; about,company,story,brand                     ;                     ;                     ; 90       ; https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=800                     ;
                             ; contact-us           ; contact ; Contact us                         ; Chat 24/7, email anytime, or call us 8am-8pm CT Monday through Saturday.                 ; "Live chat is available 24/7 on every page. Email support@thinkshop.com for anything that needs a paper trail (we reply within 4 hours during business days). Phone: 1-800-THINK-SHOP, open 8am-8pm Central, Mon-Sat. For wholesale or press inquiries, email partners@thinkshop.com."                                ; contact,support,phone,email,chat              ;                     ;                     ; 85       ;                                                                                     ;
                             ; sustainability       ; brand   ; Sustainability at ThinkShop        ; Carbon-neutral shipping, 100% recycled packaging, and a take-back program for old gear. ; "Every ThinkShop shipment is carbon-neutral — we offset emissions through verified reforestation partners. Packaging is 100% recycled and curbside-recyclable. Send us your old electronics through our take-back program and we'll recycle or refurbish them, then credit your account with ThinkPoints."             ; sustainability,green,recycling,brand          ;                     ;                     ; 60       ; https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?w=800                  ;
                             ; summer-sale-2026     ; promo   ; Summer Sale — 25% off sitewide     ; 25% off everything through July 15. No code needed, discount applied at checkout.        ; "Our biggest sale of the year is here. 25% off every product in the ThinkShop catalog, including new arrivals and the swag drop. Discount applies automatically at checkout, no code needed. Stack with ThinkPoints for even more savings. Ends July 15, 2026 at 11:59pm CT."                                       ; sale,promotion,discount,summer                ; 01.06.2026 00:00    ; 15.07.2026 23:59    ; 200      ; https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?w=800                  ;
                             ; dev-conf-2026        ; event   ; DevConf 2026 — Virtual Launch      ; Join our July 12 virtual launch event for a first look at the 2026 lineup.              ; "DevConf 2026 streams live on July 12 at 10am CT. Three hours of product demos, interviews with the ThinkShop founders, and live Q&A. Free to attend. First 500 registrants get a swag bag mailed to them. RSVP at thinkshop.com/devconf-2026."                                                                      ; event,launch,virtual,conference               ; 12.07.2026 10:00    ; 12.07.2026 14:00    ; 180      ; https://images.unsplash.com/photo-1505373877841-8d25f7d46678?w=800                  ;
                             ; swag-drop            ; promo   ; ThinkShop Swag Drop                ; New ThinkShop merch line — mugs, tees, hoodies, hats, and more. Now shipping.            ; "The ThinkShop swag drop is live. Classic and travel mugs, soft cotton tees in black and white, a heavyweight zip hoodie, dad caps, sticker packs, canvas totes, insulated bottles, and a dev notebook. Designed in Austin, made to last. Shop the full collection in the Swag category."                            ; swag,merch,apparel,promo                      ; 01.06.2026 00:00    ; 31.08.2026 23:59    ; 150      ; https://images.unsplash.com/photo-1572635148818-ef6fd45eb394?w=800                  ;
                             ; loyalty-program      ; promo   ; ThinkPoints loyalty program        ; Earn 1 point per $1 spent. 100 points = $5 off. Free to join — automatic for signed-in.  ; "ThinkPoints rewards you for shopping. Earn 1 point for every dollar spent — bonus points on swag and during promotions. 100 points converts to a $5 reward, applied automatically at your next checkout. Hit 2,500 points in a year to unlock ThinkShop Pro perks: free overnight shipping, early access to drops." ; loyalty,rewards,thinkpoints,promo             ;                     ;                     ; 130      ;                                                                                     ;
                             ; track-order          ; howto   ; How to track an order              ; Tracking links are emailed at shipment and live in your Orders page.                     ; "When your order ships you'll get an email with a tracking link. You can also sign in and open the Orders page to see status, estimated delivery, and the live tracking link. If you don't have an account, use the order number plus billing zip on thinkshop.com/track."                                          ; tracking,orders,howto                         ;                     ;                     ; 90       ;                                                                                     ;
                             ; start-return         ; howto   ; How to start a return              ; Open the order in your Orders page and click Start Return — we email a prepaid label.   ; "Sign in, open the Orders page, find the order, and click Start Return on the relevant item. Pick a reason, confirm, and we'll email you a prepaid USPS or UPS label within minutes. Drop the package at any carrier location. Refund issued 5-7 days after the warehouse scans the return."                            ; returns,howto,prepaid label                   ;                     ;                     ; 80       ;                                                                                     ;
                             ; gift-guide-under-50  ; guide   ; Gift guide — under $50             ; Easy crowd-pleasers under $50, from desk upgrades to swag for any techie.                ; "Top picks under $50 for the techie in your life — Wireless Gaming Mouse (79.99 — okay, just over), HD Webcam (89.99), or stay strictly under fifty with the ThinkShop Insulated Bottle (32), Canvas Tote (18), Travel Mug (24), Dev Notebook (16), Logo Tee (28), or a Sticker Pack stocking stuffer (6)."         ; gifts,buying guide,under 50,guide,holiday     ;                     ;                     ; 110      ; https://images.unsplash.com/photo-1513885535751-8b9238bd345a?w=800                  ;
