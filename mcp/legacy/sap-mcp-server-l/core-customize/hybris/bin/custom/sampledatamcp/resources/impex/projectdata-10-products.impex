# ---------------------------------------------------------------------------
# ThinkShop sample data
#
# Loaded automatically during "ant initialize" ONLY because the filename
# matches the pattern: projectdata-*.impex
#
# Creates: 10 products (Staged + Online), 3 customers, 3 orders
#
# Prerequisites: essentialdata-00-infrastructure.impex (catalog, store, delivery modes)
# ---------------------------------------------------------------------------

#% impex.setLocale(new java.util.Locale("en"));

$productCatalog = electronicsProductCatalog
$onlineVersion = catalogVersion(catalog(id[default = $productCatalog]), version[default = 'Online'])[unique = true]
$stagedVersion = catalogVersion(catalog(id[default = $productCatalog]), version[default = 'Staged'])[unique = true]
$taxGroup = Europe1PriceFactory_PTG(code)[default = us-sales-tax-full]
$defaultPassword = 1234
$customergroup = customergroup
$currency = USD
$language = en
$warehouse = electronics-warehouse
$store = electronics
$unit = pieces
$paymentMode = advance
$standardDeliveryMode = thinkshop-standard


# ==========================================================================
# Products (10)
# ==========================================================================

# Products are catalog-versioned — import to both Staged and Online
# Staged version (content authoring)
INSERT_UPDATE Product ; code[unique = true]   ; name[lang = $language]       ; summary[lang = $language]                                                       ; description[lang = $language]                                                                                                                                                                                                                                       ; $stagedVersion ; unit(code)[default = '$unit'] ; approvalStatus(code)[default = 'approved'] ; $taxGroup
                      ; LAPTOP_PRO_15         ; Laptop Pro 15         ; High-performance laptop with 16GB RAM and 512GB SSD                      ; The Laptop Pro 15 delivers exceptional performance with its 10th-gen Intel Core i7 processor, 16GB DDR4 RAM, and 512GB NVMe SSD. Features a stunning 15.6-inch IPS display with thin bezels, backlit keyboard, and all-day battery life up to 10 hours.        ;                ;                               ;                                            ;
                      ; SMARTPHONE_X          ; Smartphone X          ; Latest smartphone with 5G connectivity and 128GB storage                 ; Experience next-gen connectivity with Smartphone X. Powered by the latest Snapdragon chipset with 5G support, 128GB storage, and 8GB RAM. The 6.7-inch AMOLED display brings vibrant colors, while the triple-camera system captures stunning photos.          ;                ;                               ;                                            ;
                      ; WIRELESS_HEADPHONES   ; Wireless Headphones   ; Noise-cancelling wireless headphones with 30-hour battery                ; Immerse yourself in pure audio with advanced active noise cancellation. These over-ear wireless headphones deliver rich, balanced sound with 40mm custom drivers. Enjoy up to 30 hours of battery life, quick charge, and a comfortable memory-foam design.     ;                ;                               ;                                            ;
                      ; TABLET_AIR            ; Tablet Air            ; Lightweight tablet with 10.5-inch display and stylus support             ; The Tablet Air combines portability with power. Its 10.5-inch 2K display is perfect for work and play, with stylus support for drawing and note-taking. Octa-core processor, 64GB storage, and 12-hour battery life make it the ideal everyday companion.      ;                ;                               ;                                            ;
                      ; SMART_WATCH_PRO       ; Smart Watch Pro       ; Fitness tracking smartwatch with heart rate monitor                      ; Track your fitness goals with the Smart Watch Pro. Features continuous heart rate monitoring, GPS tracking, sleep analysis, and 50m water resistance. The always-on OLED display and 7-day battery life keep you connected without compromise.                 ;                ;                               ;                                            ;
                      ; MECHANICAL_KEYBOARD   ; Mechanical Keyboard   ; RGB mechanical gaming keyboard with Cherry MX switches                   ; Elevate your typing experience with genuine Cherry MX mechanical switches. Per-key RGB backlighting with 16.8 million colors, aircraft-grade aluminum frame, full N-key rollover, and programmable macros. USB-C detachable cable included.                     ;                ;                               ;                                            ;
                      ; WIRELESS_GAMING_MOUSE ; Wireless Gaming Mouse ; High-precision wireless gaming mouse with customizable buttons           ; Dominate the competition with a 25,600 DPI optical sensor and 1ms wireless response time. Features 8 programmable buttons, adjustable weight system, and up to 70 hours of battery life. Ergonomic design with textured side grips for extended gaming.        ;                ;                               ;                                            ;
                      ; MONITOR_4K_27         ; 4K Monitor 27"        ; Ultra HD 4K monitor with HDR support and 144Hz refresh rate              ; See every detail on this 27-inch Ultra HD 4K IPS display with HDR10 support and 144Hz refresh rate. Covers 99% sRGB color space, with AMD FreeSync Premium and NVIDIA G-Sync compatibility. USB-C with 65W power delivery and height-adjustable stand.        ;                ;                               ;                                            ;
                      ; HD_WEBCAM             ; HD Webcam             ; 1080p webcam with built-in microphone and auto-focus                     ; Crystal-clear 1080p video at 60fps for professional video calls and streaming. Features a wide-angle lens with auto-focus, dual noise-cancelling microphones, and automatic low-light correction. Universal clip fits any monitor or laptop.                  ;                ;                               ;                                            ;
                      ; BLUETOOTH_SPEAKER     ; Bluetooth Speaker     ; Portable Bluetooth speaker with 360-degree sound and waterproof design   ; Take your music anywhere with this IP67 waterproof and dustproof Bluetooth speaker. Delivers powerful 360-degree sound with deep bass from dual passive radiators. 20-hour battery life, built-in power bank, and pairs with a second speaker for stereo.      ;                ;                               ;                                            ;

# Online version (live storefront)
INSERT_UPDATE Product ; code[unique = true]   ; name[lang = $language]       ; summary[lang = $language]                                                       ; description[lang = $language]                                                                                                                                                                                                                                       ; $onlineVersion ; unit(code)[default = '$unit'] ; approvalStatus(code)[default = 'approved'] ; $taxGroup
                      ; LAPTOP_PRO_15         ; Laptop Pro 15         ; High-performance laptop with 16GB RAM and 512GB SSD                      ; The Laptop Pro 15 delivers exceptional performance with its 10th-gen Intel Core i7 processor, 16GB DDR4 RAM, and 512GB NVMe SSD. Features a stunning 15.6-inch IPS display with thin bezels, backlit keyboard, and all-day battery life up to 10 hours.        ;                ;                                ;                                            ;
                      ; SMARTPHONE_X          ; Smartphone X          ; Latest smartphone with 5G connectivity and 128GB storage                 ; Experience next-gen connectivity with Smartphone X. Powered by the latest Snapdragon chipset with 5G support, 128GB storage, and 8GB RAM. The 6.7-inch AMOLED display brings vibrant colors, while the triple-camera system captures stunning photos.          ;                ;                                ;                                            ;
