<?xml version="1.0" encoding="UTF-8"?>
<!--
 coremcp — Service-layer Spring beans.
 Tool handlers, MCP services, and Agent services.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <context:annotation-config/>

    <!-- ===================================================================
         Deep Link Builder — produces storefront URLs for products, orders,
         and categories using the configurable coremcp.storefront.baseUrl.
         =================================================================== -->

    <alias name="defaultDeepLinkBuilder" alias="deepLinkBuilder"/>
    <bean id="defaultDeepLinkBuilder"
          class="com.coremcp.services.DeepLinkBuilder"/>

    <!-- ===================================================================
         Tool Handlers
         =================================================================== -->

    <alias name="defaultProductSearchToolHandler" alias="productSearchToolHandler"/>
    <bean id="defaultProductSearchToolHandler"
          class="com.coremcp.tools.impl.ProductSearchToolHandler">
        <property name="productSearchFacade" ref="productSearchFacade"/>
        <property name="deepLinkBuilder" ref="deepLinkBuilder"/>
    </bean>

    <alias name="defaultProductGetToolHandler" alias="productGetToolHandler"/>
    <bean id="defaultProductGetToolHandler"
          class="com.coremcp.tools.impl.ProductGetToolHandler">
        <property name="productFacade" ref="productFacade"/>
        <property name="deepLinkBuilder" ref="deepLinkBuilder"/>
    </bean>

    <alias name="defaultCartGetToolHandler" alias="cartGetToolHandler"/>
    <bean id="defaultCartGetToolHandler"
          class="com.coremcp.tools.impl.CartGetToolHandler">
        <property name="cartFacade" ref="cartFacade"/>
    </bean>

    <alias name="defaultCartAddProductToolHandler" alias="cartAddProductToolHandler"/>
    <bean id="defaultCartAddProductToolHandler"
          class="com.coremcp.tools.impl.CartAddProductToolHandler">
        <property name="cartFacade" ref="cartFacade"/>
    </bean>

    <alias name="defaultCartUpdateEntryToolHandler" alias="cartUpdateEntryToolHandler"/>
    <bean id="defaultCartUpdateEntryToolHandler"
          class="com.coremcp.tools.impl.CartUpdateEntryToolHandler">
        <property name="cartFacade" ref="cartFacade"/>
    </bean>

    <alias name="defaultCartRemoveEntryToolHandler" alias="cartRemoveEntryToolHandler"/>
    <bean id="defaultCartRemoveEntryToolHandler"
          class="com.coremcp.tools.impl.CartRemoveEntryToolHandler">
        <property name="cartFacade" ref="cartFacade"/>
    </bean>

    <alias name="defaultCartApplyVoucherToolHandler" alias="cartApplyVoucherToolHandler"/>
    <bean id="defaultCartApplyVoucherToolHandler"
          class="com.coremcp.tools.impl.CartApplyVoucherToolHandler">
        <property name="voucherFacade" ref="voucherFacade"/>
    </bean>

    <alias name="defaultCartRemoveVoucherToolHandler" alias="cartRemoveVoucherToolHandler"/>
    <bean id="defaultCartRemoveVoucherToolHandler"
          class="com.coremcp.tools.impl.CartRemoveVoucherToolHandler">
        <property name="voucherFacade" ref="voucherFacade"/>
    </bean>

    <alias name="defaultOrderGetToolHandler" alias="orderGetToolHandler"/>
    <bean id="defaultOrderGetToolHandler"
          class="com.coremcp.tools.impl.OrderGetToolHandler">
        <property name="orderFacade" ref="orderFacade"/>
        <property name="deepLinkBuilder" ref="deepLinkBuilder"/>
    </bean>

    <alias name="defaultOrderHistoryToolHandler" alias="orderHistoryToolHandler"/>
    <bean id="defaultOrderHistoryToolHandler"
          class="com.coremcp.tools.impl.OrderHistoryToolHandler">
        <property name="orderFacade" ref="orderFacade"/>
        <property name="deepLinkBuilder" ref="deepLinkBuilder"/>
    </bean>

    <alias name="defaultCustomerGetToolHandler" alias="customerGetToolHandler"/>
    <bean id="defaultCustomerGetToolHandler"
          class="com.coremcp.tools.impl.CustomerGetToolHandler">
        <property name="customerFacade" ref="customerFacade"/>
    </bean>

    <alias name="defaultCustomerLookupToolHandler" alias="customerLookupToolHandler"/>
    <bean id="defaultCustomerLookupToolHandler"
          class="com.coremcp.tools.impl.CustomerLookupToolHandler">
        <property name="customerFacade" ref="customerFacade"/>
    </bean>

    <alias name="defaultUIActionToolHandler" alias="uiActionToolHandler"/>
    <bean id="defaultUIActionToolHandler"
          class="com.coremcp.tools.impl.UIActionToolHandler"/>

    <alias name="defaultCheckoutSetDeliveryAddressToolHandler" alias="checkoutSetDeliveryAddressToolHandler"/>
    <bean id="defaultCheckoutSetDeliveryAddressToolHandler"
          class="com.coremcp.tools.impl.CheckoutSetDeliveryAddressToolHandler">
        <property name="checkoutFacade" ref="checkoutFacade"/>
    </bean>

    <alias name="defaultCheckoutSetDeliveryModeToolHandler" alias="checkoutSetDeliveryModeToolHandler"/>
    <bean id="defaultCheckoutSetDeliveryModeToolHandler"
          class="com.coremcp.tools.impl.CheckoutSetDeliveryModeToolHandler">
        <property name="checkoutFacade" ref="checkoutFacade"/>
    </bean>

    <alias name="defaultCheckoutSetPaymentToolHandler" alias="checkoutSetPaymentToolHandler"/>
    <bean id="defaultCheckoutSetPaymentToolHandler"
          class="com.coremcp.tools.impl.CheckoutSetPaymentToolHandler">
        <property name="checkoutFacade" ref="checkoutFacade"/>
    </bean>

    <alias name="defaultOrderPlaceToolHandler" alias="orderPlaceToolHandler"/>
    <bean id="defaultOrderPlaceToolHandler"
          class="com.coremcp.tools.impl.OrderPlaceToolHandler">
        <property name="checkoutFacade" ref="checkoutFacade"/>
    </bean>

    <alias name="defaultPromotionsGetToolHandler" alias="promotionsGetToolHandler"/>
    <bean id="defaultPromotionsGetToolHandler"
          class="com.coremcp.tools.impl.PromotionsGetToolHandler">
        <property name="promotionQueryService" ref="promotionQueryService"/>
    </bean>

    <alias name="defaultInfoGetToolHandler" alias="infoGetToolHandler"/>
    <bean id="defaultInfoGetToolHandler"
          class="com.coremcp.tools.impl.InfoGetToolHandler">
        <property name="knowledgeSearchService" ref="knowledgeSearchService"/>
    </bean>

    <alias name="defaultInfoSearchToolHandler" alias="infoSearchToolHandler"/>
    <bean id="defaultInfoSearchToolHandler"
          class="com.coremcp.tools.impl.InfoSearchToolHandler">
        <property name="knowledgeSearchService" ref="knowledgeSearchService"/>
    </bean>

    <!-- ===================================================================
         Knowledge Search Service — thin Solr wrapper over knowledgeIndex,
         same shape as ProductSearchFacade.textSearch but for KnowledgeEntry.
         Returns Solr Documents directly; no Model load, no FlexibleSearch.
         =================================================================== -->

    <alias name="defaultKnowledgeSearchService" alias="knowledgeSearchService"/>
    <bean id="defaultKnowledgeSearchService"
          class="com.coremcp.services.impl.DefaultKnowledgeSearchService">
        <property name="facetSearchService" ref="facetSearchService"/>
        <property name="facetSearchConfigService" ref="facetSearchConfigService"/>
    </bean>

    <!-- ===================================================================
         Promotion Query Service (data access for promotions/coupons)
         =================================================================== -->

    <alias name="defaultPromotionQueryService" alias="promotionQueryService"/>
    <bean id="defaultPromotionQueryService"
          class="com.coremcp.services.impl.DefaultPromotionQueryService">
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
        <property name="userService" ref="userService"/>
    </bean>

    <!-- ===================================================================
         MCP Cart Session Service (cart loading/persistence for controllers)
         =================================================================== -->

    <alias name="defaultMcpCartSessionService" alias="mcpCartSessionService"/>
    <bean id="defaultMcpCartSessionService"
          class="com.coremcp.services.impl.DefaultMcpCartSessionService">
        <property name="cartLoaderStrategy" ref="cartLoaderStrategy"/>
        <property name="cartService" ref="cartService"/>
    </bean>

    <!-- ===================================================================
         MCP Session Service — backing store selected at boot via
         coremcp.session.store (persistent = DB-backed/cluster-safe, default;
         memory = in-process/single-node).
         =================================================================== -->

    <alias name="inMemoryMcpSessionService" alias="memoryMcpSessionService"/>
    <bean id="inMemoryMcpSessionService"
          class="com.coremcp.services.impl.DefaultMcpSessionService">
        <property name="ttlMinutes" value="${coremcp.session.ttl.minutes}"/>
    </bean>

    <alias name="persistedMcpSessionService" alias="persistentMcpSessionService"/>
    <bean id="persistedMcpSessionService"
          class="com.coremcp.services.impl.PersistedMcpSessionService">
        <property name="modelService" ref="modelService"/>
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
        <property name="ttlMinutes" value="${coremcp.session.ttl.minutes}"/>
    </bean>

    <alias name="defaultMcpSessionService" alias="mcpSessionService"/>
    <bean id="defaultMcpSessionService"
          class="com.coremcp.services.impl.DelegatingMcpSessionService">
        <property name="store" value="${coremcp.session.store}"/>
        <property name="memoryStore" ref="memoryMcpSessionService"/>
        <property name="persistentStore" ref="persistentMcpSessionService"/>
    </bean>

    <!-- Sweeps abandoned expired sessions from the persistent store (see
         essentialdata-mcp-session-cleanup.impex for the CronJob/Trigger). -->
    <bean id="mcpSessionCleanupJob"
          class="com.coremcp.jobs.McpSessionCleanupJob"
          parent="abstractJobPerformable"/>

    <!-- ===================================================================
         MCP Dispatcher Service
         =================================================================== -->

    <alias name="defaultMcpDispatcherService" alias="mcpDispatcherService"/>
    <bean id="defaultMcpDispatcherService"
          class="com.coremcp.services.impl.DefaultMcpDispatcherService">
        <property name="mcpSessionService" ref="mcpSessionService"/>
        <property name="toolHandlers">
            <list>
                <ref bean="productSearchToolHandler"/>
                <ref bean="productGetToolHandler"/>
                <ref bean="cartGetToolHandler"/>
                <ref bean="cartAddProductToolHandler"/>
                <ref bean="cartUpdateEntryToolHandler"/>
                <ref bean="cartRemoveEntryToolHandler"/>
                <ref bean="cartApplyVoucherToolHandler"/>
                <ref bean="cartRemoveVoucherToolHandler"/>
                <ref bean="orderGetToolHandler"/>
                <ref bean="orderHistoryToolHandler"/>
                <ref bean="customerGetToolHandler"/>
                <ref bean="customerLookupToolHandler"/>
                <ref bean="checkoutSetDeliveryAddressToolHandler"/>
                <ref bean="checkoutSetDeliveryModeToolHandler"/>
                <ref bean="checkoutSetPaymentToolHandler"/>
                <ref bean="orderPlaceToolHandler"/>
                <ref bean="promotionsGetToolHandler"/>
                <ref bean="infoGetToolHandler"/>
                <ref bean="infoSearchToolHandler"/>
            </list>
        </property>
    </bean>

    <!-- ===================================================================
         Visual Search Service
         =================================================================== -->

    <alias name="defaultVisualSearchService" alias="visualSearchService"/>
    <bean id="defaultVisualSearchService"
          class="com.coremcp.services.impl.DefaultVisualSearchService">
        <property name="llmClient" ref="llmClient"/>
        <property name="productSearchFacade" ref="productSearchFacade"/>
        <property name="visionModel" value="${coremcp.visualsearch.model}"/>
        <property name="maxResults" value="${coremcp.visualsearch.maxResults}"/>
    </bean>

    <!-- ===================================================================
         LLM Client and Providers
         =================================================================== -->

    <!-- Shared HTTP resilience defaults for all LLM providers (see AbstractHttpLlmProvider). -->
    <bean id="abstractHttpLlmProvider" abstract="true">
        <property name="retryMaxAttempts" value="${coremcp.llm.retry.maxAttempts}"/>
        <property name="retryBaseDelayMillis" value="${coremcp.llm.retry.baseDelayMillis}"/>
    </bean>

    <alias name="defaultOpenAiLlmProvider" alias="openAiLlmProvider"/>
    <bean id="defaultOpenAiLlmProvider" parent="abstractHttpLlmProvider"
          class="com.coremcp.services.impl.OpenAiLlmProvider"/>

    <alias name="defaultAnthropicLlmProvider" alias="anthropicLlmProvider"/>
    <bean id="defaultAnthropicLlmProvider" parent="abstractHttpLlmProvider"
          class="com.coremcp.services.impl.AnthropicLlmProvider"/>

    <alias name="defaultOpenAiCompatibleLlmProvider" alias="openAiCompatibleLlmProvider"/>
    <bean id="defaultOpenAiCompatibleLlmProvider" parent="abstractHttpLlmProvider"
          class="com.coremcp.services.impl.OpenAiCompatibleLlmProvider"/>

    <alias name="defaultGeminiLlmProvider" alias="geminiLlmProvider"/>
    <bean id="defaultGeminiLlmProvider" parent="abstractHttpLlmProvider"
          class="com.coremcp.services.impl.GeminiLlmProvider"/>

    <alias name="defaultLlmClient" alias="llmClient"/>
    <bean id="defaultLlmClient"
          class="com.coremcp.services.impl.DefaultLlmClient">
        <property name="providers">
            <list>
                <ref bean="openAiLlmProvider"/>
                <ref bean="anthropicLlmProvider"/>
                <ref bean="openAiCompatibleLlmProvider"/>
                <ref bean="geminiLlmProvider"/>
            </list>
        </property>
    </bean>

    <!-- ===================================================================
         Agent Rate Limiter — per-user request budget for /agent/* endpoints
         (every request triggers paid LLM calls). 0 disables.
         =================================================================== -->

    <alias name="defaultAgentRateLimiter" alias="agentRateLimiter"/>
    <bean id="defaultAgentRateLimiter"
          class="com.coremcp.services.impl.DefaultAgentRateLimiter">
        <property name="requestsPerMinute" value="${coremcp.agent.rateLimit.perMinute}"/>
    </bean>

    <!-- ===================================================================
         Agent Service and collaborators (state snapshot, entity refs,
         tool invocation) — see AgentService / AgentToolInvoker interfaces.
         =================================================================== -->

    <alias name="defaultAgentStateSnapshotBuilder" alias="agentStateSnapshotBuilder"/>
    <bean id="defaultAgentStateSnapshotBuilder"
          class="com.coremcp.services.impl.DefaultAgentStateSnapshotBuilder">
        <property name="cartFacade" ref="cartFacade"/>
        <property name="customerFacade" ref="customerFacade"/>
    </bean>

    <alias name="defaultEntityRefCollector" alias="entityRefCollector"/>
    <bean id="defaultEntityRefCollector"
          class="com.coremcp.services.impl.DefaultEntityRefCollector"/>

    <alias name="defaultAgentToolInvoker" alias="agentToolInvoker"/>
    <bean id="defaultAgentToolInvoker"
          class="com.coremcp.services.impl.DefaultAgentToolInvoker">
        <property name="entityRefCollector" ref="entityRefCollector"/>
        <property name="toolHandlers">
            <list>
                <ref bean="productSearchToolHandler"/>
                <ref bean="productGetToolHandler"/>
                <ref bean="cartGetToolHandler"/>
                <ref bean="cartAddProductToolHandler"/>
                <ref bean="cartUpdateEntryToolHandler"/>
                <ref bean="cartRemoveEntryToolHandler"/>
                <ref bean="cartApplyVoucherToolHandler"/>
                <ref bean="cartRemoveVoucherToolHandler"/>
                <ref bean="orderGetToolHandler"/>
                <ref bean="orderHistoryToolHandler"/>
                <ref bean="customerGetToolHandler"/>
                <ref bean="customerLookupToolHandler"/>
                <ref bean="checkoutSetDeliveryAddressToolHandler"/>
                <ref bean="checkoutSetDeliveryModeToolHandler"/>
                <ref bean="checkoutSetPaymentToolHandler"/>
                <ref bean="orderPlaceToolHandler"/>
                <ref bean="promotionsGetToolHandler"/>
                <ref bean="infoGetToolHandler"/>
                <ref bean="infoSearchToolHandler"/>
                <ref bean="uiActionToolHandler"/>
            </list>
        </property>
    </bean>

    <alias name="defaultAgentService" alias="agentService"/>
    <bean id="defaultAgentService"
          class="com.coremcp.services.impl.DefaultAgentService">
        <property name="maxToolIterations" value="${coremcp.agent.maxToolIterations}"/>
        <property name="toolResultSummaryThreshold" value="${coremcp.agent.toolResult.summaryThreshold}"/>
        <property name="toolResultSummarySnippet" value="${coremcp.agent.toolResult.summarySnippet}"/>
        <property name="llmClient" ref="llmClient"/>
        <property name="stateSnapshotBuilder" ref="agentStateSnapshotBuilder"/>
        <property name="toolInvoker" ref="agentToolInvoker"/>
        <property name="toolHandlers">
            <list>
                <ref bean="productSearchToolHandler"/>
                <ref bean="productGetToolHandler"/>
                <ref bean="cartGetToolHandler"/>
                <ref bean="cartAddProductToolHandler"/>
                <ref bean="cartUpdateEntryToolHandler"/>
                <ref bean="cartRemoveEntryToolHandler"/>
                <ref bean="cartApplyVoucherToolHandler"/>
                <ref bean="cartRemoveVoucherToolHandler"/>
                <ref bean="orderGetToolHandler"/>
                <ref bean="orderHistoryToolHandler"/>
                <ref bean="customerGetToolHandler"/>
                <ref bean="customerLookupToolHandler"/>
                <ref bean="checkoutSetDeliveryAddressToolHandler"/>
                <ref bean="checkoutSetDeliveryModeToolHandler"/>
                <ref bean="checkoutSetPaymentToolHandler"/>
                <ref bean="orderPlaceToolHandler"/>
                <ref bean="promotionsGetToolHandler"/>
                <ref bean="infoGetToolHandler"/>
                <ref bean="infoSearchToolHandler"/>
                <ref bean="uiActionToolHandler"/>
            </list>
        </property>
    </bean>

</beans>
