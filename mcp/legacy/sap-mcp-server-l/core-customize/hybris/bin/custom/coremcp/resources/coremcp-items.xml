<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
 coremcp item types.

 KnowledgeEntry — shopper-facing knowledge base entries surfaced via the
 info_get / info_search OCC endpoints and MCP tools. Covers policies,
 marketing/events, brand content, how-tos and buying guides.

 McpSessionEntry — DB-backed MCP session state so conversations survive
 multi-node CCv2 routing (agent clients send headers, not cookies, so
 ingress stickiness cannot be relied on) and rolling deployments. Used by
 PersistedMcpSessionService; expired rows are removed by
 mcpSessionCleanupCronJob.
-->

<items xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="items.xsd">

    <enumtypes>
        <enumtype code="KnowledgeCategory" autocreate="true" generate="true">
            <value code="policy"/>
            <value code="event"/>
            <value code="promo"/>
            <value code="guide"/>
            <value code="brand"/>
            <value code="howto"/>
            <value code="contact"/>
        </enumtype>

        <enumtype code="KnowledgeStatus" autocreate="true" generate="true">
            <value code="draft"/>
            <value code="published"/>
        </enumtype>
    </enumtypes>

    <itemtypes>
        <itemtype code="KnowledgeEntry"
                  autocreate="true"
                  generate="true">
            <deployment table="KnowledgeEntries" typecode="14001"/>
            <attributes>
                <attribute qualifier="uid" type="java.lang.String">
                    <persistence type="property"/>
                    <modifiers unique="true" optional="false"/>
                </attribute>
                <attribute qualifier="category" type="KnowledgeCategory">
                    <persistence type="property"/>
                    <modifiers optional="false"/>
                </attribute>
                <attribute qualifier="title" type="localized:java.lang.String">
                    <persistence type="property"/>
                    <modifiers optional="false"/>
                </attribute>
                <attribute qualifier="summary" type="localized:java.lang.String">
                    <persistence type="property">
                        <columntype><value>HYBRIS.LONG_STRING</value></columntype>
                    </persistence>
                </attribute>
                <attribute qualifier="body" type="localized:java.lang.String">
                    <persistence type="property">
                        <columntype><value>HYBRIS.LONG_STRING</value></columntype>
                    </persistence>
                </attribute>
                <attribute qualifier="tags" type="java.lang.String">
                    <description>Comma-separated tag list.</description>
                    <persistence type="property"/>
                </attribute>
                <attribute qualifier="validFrom" type="java.util.Date">
                    <persistence type="property"/>
                </attribute>
                <attribute qualifier="validTo" type="java.util.Date">
                    <persistence type="property"/>
                </attribute>
                <attribute qualifier="priority" type="java.lang.Integer">
                    <persistence type="property"/>
                    <defaultvalue>Integer.valueOf(0)</defaultvalue>
                </attribute>
                <attribute qualifier="imageUrl" type="java.lang.String">
                    <persistence type="property">
                        <columntype><value>HYBRIS.LONG_STRING</value></columntype>
                    </persistence>
                </attribute>
                <attribute qualifier="status" type="KnowledgeStatus">
                    <persistence type="property"/>
                    <defaultvalue>em().getEnumerationValue("KnowledgeStatus", "draft")</defaultvalue>
                    <modifiers optional="false"/>
                </attribute>
            </attributes>
        </itemtype>

        <itemtype code="McpSessionEntry"
                  autocreate="true"
                  generate="true">
            <deployment table="McpSessionEntries" typecode="14002"/>
            <attributes>
                <attribute qualifier="sessionId" type="java.lang.String">
                    <persistence type="property"/>
                    <modifiers unique="true" optional="false"/>
                </attribute>
                <attribute qualifier="protocolVersion" type="java.lang.String">
                    <persistence type="property"/>
                </attribute>
                <attribute qualifier="clientInfoJson" type="java.lang.String">
                    <description>Client info from the MCP initialize request, serialized as JSON.</description>
                    <persistence type="property">
                        <columntype><value>HYBRIS.LONG_STRING</value></columntype>
                    </persistence>
                </attribute>
                <attribute qualifier="cartCode" type="java.lang.String">
                    <persistence type="property"/>
                </attribute>
                <attribute qualifier="lastAccessedAt" type="java.util.Date">
                    <persistence type="property"/>
                    <modifiers optional="false"/>
                </attribute>
            </attributes>
            <indexes>
                <index name="mcpSessionIdIdx" unique="true">
                    <key attribute="sessionId"/>
                </index>
                <index name="mcpSessionLastAccessIdx">
                    <key attribute="lastAccessedAt"/>
                </index>
            </indexes>
        </itemtype>
    </itemtypes>
</items>
