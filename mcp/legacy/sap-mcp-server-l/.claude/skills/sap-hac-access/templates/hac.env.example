# HAC environments for this project.
#
# Local HAC needs nothing here — the bundled scripts default to
# https://localhost:9002, admin/nimda, Java 21, root context.
#
# Fill in only the environments you actually use. Leave the rest commented out.
# NEVER commit real passwords: keep this file in .gitignore and treat it as a secret.

# --- dev ---
# dev_hac_url=https://dev-host.example.com
# dev_admin_user=admin
# dev_admin_password=

# --- qa ---
# qa_hac_url=https://qa-host.example.com
# qa_admin_user=admin
# qa_admin_password=

# --- uat ---
# uat_hac_url=https://uat-host.example.com
# uat_admin_user=admin
# uat_admin_password=

# --- stage ---
# stage_hac_url=https://stage-host.example.com
# stage_admin_user=admin
# stage_admin_password=

# PROD is deliberately absent. The skill never targets PROD.

# Optional per-environment overrides, only when the defaults don't match.
# Java line and HAC web context are tracked separately: HAC mounted under /hac
# needs the context path even on Java 21.
# dev_hac_java_version=21
# dev_hac_context_path=/hac
