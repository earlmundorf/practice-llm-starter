# Hybris platform and modules (unpacked by bootstrapPlatform)
core-customize/hybris/bin/platform
core-customize/hybris/bin/modules

# Build artifacts
core-customize/hybris/bin/custom/*/gensrc/
core-customize/hybris/bin/custom/*/classes/
core-customize/hybris/bin/custom/*/eclipsebin/

# Generated by ant build (contains absolute platform path)
core-customize/hybris/bin/custom/*/platformhome.properties
core-customize/hybris/temp/
core-customize/hybris/data/
core-customize/hybris/log/
core-customize/hybris/roles/

# Generated config (created by bootstrapPlatform + setupConfig)
core-customize/hybris/config/

# Platform-generated build and schema files
core-customize/hybris/bin/custom/*/build.xml
core-customize/hybris/bin/custom/*/extensioninfo.xsd
core-customize/hybris/bin/custom/*/resources/items.xsd
core-customize/hybris/bin/custom/*/resources/beans.xsd

# SAP Commerce ZIP files (licensed, not checked in)
core-customize/dependencies/*
!core-customize/dependencies/.gitkeep

# Gradle build output
core-customize/build/
core-customize/.gradle/

# Claude Code local settings
.claude/settings.local.json

# IDE
.idea/
*.iml
.project
.classpath
.settings/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# QRSPI per-ticket working artifacts — only the shared build-adapter config is tracked
working-docs/*
!working-docs/config.json
!working-docs/findings/
!working-docs/findings/**
