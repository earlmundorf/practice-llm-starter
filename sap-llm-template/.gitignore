# Hybris platform and modules (symlinked or downloaded by CCv2 build)
core-customize/hybris/bin/platform
core-customize/hybris/bin/modules

# Build artifacts
core-customize/hybris/bin/custom/*/gensrc/
core-customize/hybris/bin/custom/*/classes/
core-customize/hybris/bin/custom/*/eclipsebin/

# Generated by ant build (contains absolute platform path)
core-customize/hybris/bin/custom/*/platformhome.properties
core-customize/hybris/temp/
core-customize/hybris/data/
core-customize/hybris/log/
core-customize/hybris/roles/

# Platform-generated config
core-customize/hybris/config/customize/
core-customize/hybris/config/languages/
core-customize/hybris/config/solr/
core-customize/hybris/config/tomcat/

# Platform-generated build and schema files (overwritten on ant build)
core-customize/hybris/bin/custom/*/build.xml
core-customize/hybris/bin/custom/*/extensioninfo.xsd
core-customize/hybris/bin/custom/*/resources/items.xsd
core-customize/hybris/bin/custom/*/resources/beans.xsd

# Licence files
core-customize/hybris/config/licence/

# Local script logs
local/logs/

# Claude Code local settings (machine-specific permissions, globally gitignored)
# Copy .claude/settings.local.json.example to .claude/settings.local.json
.claude/settings.local.json

# IDE
.idea/
.vscode/
*.iml
.project
.classpath
.settings/
*.swp
*.swo
*~

